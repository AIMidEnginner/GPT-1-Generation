local Config = {}

local function makeMatrix16x16(scale)
	local matrix = {}
	for i = 1, 16 do
		matrix[i] = {}
		for j = 1, 16 do
			-- Pseudolosowe rozproszenie wartości oparte na indeksach (stabilne i powtarzalne dla configu)
			matrix[i][j] = math.sin(i * j) * (scale or 0.15)
		end
	end
	return matrix
end

local function makeZeroVector16()
	local vec = {}
	for i = 1, 16 do vec[i] = 0.0 end
	return vec
end

