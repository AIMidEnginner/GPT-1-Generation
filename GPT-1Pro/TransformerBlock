local Config = require(script.Parent.Data)
local Buffer = {}

local math_sqrt = math.sqrt
local math_tanh = math.tanh
local math_exp = math.exp
local math_huge = math.huge
local Q_Buf, K_Buf, V_Buf = {}, {}, {}
local Head_Scores_Buf = {}
local Head_Context_Buf = {}
local Hidden_Buffer = {}
local Dropout_RNG = Random.new(42)

