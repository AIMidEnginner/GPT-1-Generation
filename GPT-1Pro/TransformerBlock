--HELPERS
-------------------------------------------------------------------

function Softmax(vector)
	local size = #vector
	if size == 0 then return end

	local max_val = -math_huge
	for i = 1, size do
		local val = vector[i]
		if val > max_val then
			max_val = val
		end
	end

	-- 2. OBLICZANIE EXP + SUMOWANIE (In-place)
	local sum = 0.0
	for i = 1, size do
		-- Trik z maksimum: math.exp(val - max_val)
		local e = math_exp(vector[i] - max_val)
		vector[i] = e
		sum = sum + e
	end

	if sum < 1e-9 then 
		sum = 1e-9 
	end

	local inv_sum = 1.0 / sum

	for i = 1, size do
		vector[i] = vector[i] * inv_sum
	end
end

function matmul(A, B, out_buffer, transpose_B)
	local M = #A     
	local N = #A[1]  

	if transpose_B then
		local K_rows = #B 
		for i = 1, M do
			local row_A = A[i]
			local row_out = out_buffer[i]
			for j = 1, K_rows do
				local row_B = B[j] 
				local sum = 0.0
				for k = 1, N do 
					sum = sum + row_A[k] * row_B[k] 
				end
				row_out[j] = sum
			end
		end
	else
		-- Zabezpieczenie przed niezealokowanym jeszcze out_buffer (odczytujemy szerokość z wag B)
		local P = #B[1] 

		for i = 1, M do
			local row_out = out_buffer[i]
			-- Jeśli linia w buforze nie ma jeszcze odpowiedniej długości, tworzymy ją w locie
			if not row_out or #row_out < P then
				out_buffer[i] = table.create(P, 0.0)
				row_out = out_buffer[i]
			else
				for j = 1, P do row_out[j] = 0.0 end
			end
		end

		for i = 1, M do
			local row_A = A[i]
			local row_out = out_buffer[i]
			for k = 1, N do
				local val_A = row_A[k]
				if val_A ~= 0.0 then
					local row_B = B[k]
					for j = 1, P do 
						row_out[j] = row_out[j] + val_A * row_B[j] 
					end
				end
			end
		end
	end
end

local function GELU(x)
	return 0.5 * x * (1 + math_tanh(0.79788456 * x * (1 + 0.044715 * x * x)))
end

local function ApplyDropout(x)
	if not Config.DropoutEnabled then
		return x
	end

	if Dropout_RNG:NextNumber() < Config.Dropout then
		return 0
	end

	return x / (1 - Config.Dropout)
end

