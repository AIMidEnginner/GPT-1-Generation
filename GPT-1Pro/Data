local ex = false

function module.exportConfigToOutput()
	if ex == true then return end
	ex = true

	print("--- ROZPOCZĘCIE EKSPORTU MODELU (Może to zająć chwilę) ---")
	task.wait(1)

	-- Funkcja do drukowania wektorów 1D (np. Biases, LN_gamma) z łamaniem na chunki
	local function print1D(keyName, array, indent, addComma)
		local str = indent .. keyName .. " = { "
		for i = 1, #array do
			str = str .. string.format("% .6f", array[i])
			if i < #array then str = str .. ", " end

			-- Łamanie długiej linii co 16 liczb
			if i % 16 == 0 and i < #array then
				print(str)
				str = indent .. "\t"
			end
		end
		str = str .. " }" .. (addComma and "," or "")
		print(str)
	end

	-- Funkcja do drukowania macierzy 2D (np. Wq, Wk, Wv, Weights)
	local function print2D(keyName, matrix, indent, vocabs, addComma)
		print(indent .. keyName .. " = {")
		for i = 1, #matrix do
			local row = matrix[i]
			if type(row) == "table" then
				local str = indent .. "\t[" .. i .. "] = { "
				for j = 1, #row do
					str = str .. string.format("% .6f", row[j])
					if j < #row then str = str .. ", " end

					-- Złamanie wewnątrz wiersza co 16 liczb
					if j % 16 == 0 and j < #row then
						print(str)
						str = indent .. "\t\t"
					end
				end
				local comment = vocabs and (" -- " .. tostring(vocabs[i] or "?")) or ""
				str = str .. " }," .. comment
				print(str)
			end

			-- Zabezpieczenie przed Timeout'em w Roblox Studio
			if i % 20 == 0 then task.wait() end 
		end
		print(indent .. "}" .. (addComma and "," or ""))
	end

	print("local module = {}")
	print("")

	-- 1. Podstawowe parametry
	print("module.num_layers = " .. tostring(module.num_layers))
	print("module.Heads = " .. tostring(module.Heads))
	print("module.D = " .. tostring(module.D))
	print("module.Temperature = " .. tostring(module.Temperature or 1.0))
	print("module.Context_Length = " .. tostring(module.Context_Length or 128))
	print("module.DropoutEnabled = " .. tostring(module.DropoutEnabled or false))
	print("module.Dropout = " .. tostring(module.Dropout or 0.1))
	print("")

	-- 2. Vocab
	print("module.Vocab = {")
	local vocabStr = "\t"
	for i, word in ipairs(module.Vocab) do
		vocabStr = vocabStr .. '"' .. word .. '"'
		if i < #module.Vocab then vocabStr = vocabStr .. ", " end

		-- 10 słów w linii
		if i % 10 == 0 and i < #module.Vocab then
			print(vocabStr)
			vocabStr = "\t"
		end
	end
	print(vocabStr)
	print("}")
	print("")

	-- 3. WordToID (Automatyczne generowanie przy starcie)
	print("module.WordToID = {}")
	print("for id, word in ipairs(module.Vocab) do")
	print("\tmodule.WordToID[word] = id")
	print("end")
	print("")
	task.wait()

	-- 4. Embedding Table
	print2D("module.EmbeddingTable", module.EmbeddingTable, "", module.Vocab, false)
	print("")

	-- 5. LM Head
	print("module.LM_Head = {")
	print2D("weights", module.LM_Head.weights, "\t", module.Vocab, true)
	print1D("biases", module.LM_Head.biases, "\t", false)
	print("}")
	print("")

	-- 6. Feed Forward
	print("module.FeedForward = {")

	print("\t[1] = {")
	print2D("Weights", module.FeedForward[1].Weights, "\t\t", nil, true)
	print1D("Biases", module.FeedForward[1].Biases, "\t\t", false)
	print("\t},")
	task.wait()

	print("\t[2] = {")
	print2D("Weights", module.FeedForward[2].Weights, "\t\t", nil, true)
	print1D("Biases", module.FeedForward[2].Biases, "\t\t", false)
	print("\t}")
	print("}")
	print("")

	-- 7. Warstwy Transformera
	print("module.warstwy = {")
	for l = 1, module.num_layers do
		local layer = module.warstwy[l]
		print("\t[" .. l .. "] = {")

		print1D("LN1_gamma", layer.LN1_gamma, "\t\t", true)
		print1D("LN1_beta", layer.LN1_beta, "\t\t", true)
		print("")

		print2D("Wq", layer.Wq, "\t\t", nil, true)
		print2D("Wk", layer.Wk, "\t\t", nil, true)
		print2D("Wv", layer.Wv, "\t\t", nil, true)
		print2D("Wo", layer.Wo, "\t\t", nil, true)

		print1D("Bq", layer.Bq, "\t\t", true)
		print1D("Bk", layer.Bk, "\t\t", true)
		print1D("Bv", layer.Bv, "\t\t", true)
		print1D("Bo", layer.Bo, "\t\t", true)
		print("")

		print1D("LN2_gamma", layer.LN2_gamma, "\t\t", true)
		print1D("LN2_beta", layer.LN2_beta, "\t\t", false)

		print("\t},")
		task.wait()
	end
	print("}")
	print("")

