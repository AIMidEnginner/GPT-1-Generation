local function CloneVector(X)
	local Result = table.create(#X)

	for i = 1, #X do
		Result[i] = X[i]
	end

	return Result
end

local function CloneSequence(X)
	local Result = table.create(#X)

	for i = 1, #X do
		Result[i] = CloneVector(X[i])
	end

	return Result
end

