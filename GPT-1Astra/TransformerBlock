local Data = script.Parent:WaitForChild("Data")
local Config = require(Data:WaitForChild("Config"))
local Params = require(Data:WaitForChild("Params"))

local TransformerBlock = {}

local D = Config.Dimension
local Heads = Config.Model.Heads
local Hidden = Config.Model.FFNSize or D * 4
local ContextSize = Config.Model.ContextSize

if D % Heads ~= 0 then
	error("Dimension must be divisible by Heads")
end

local HeadDim = D / Heads
local Scale = 1 / math.sqrt(HeadDim)

local RNG = Random.new(42)

----------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------

local function CloneVector(X)
	local Result = table.create(#X)

	for i = 1, #X do
		Result[i] = X[i]
	end

	return Result
end

local function CloneSequence(X)
	local Result = table.create(#X)

	for i = 1, #X do
		Result[i] = CloneVector(X[i])
	end

	return Result
end

local function Linear(X, W, B)
	local N = #X
	local OutSize = #W[1]
	local Result = table.create(N)

	for i = 1, N do
		local Xi = X[i]
		local Row = table.create(OutSize)

		for j = 1, OutSize do
			local Sum = B and B[j] or 0

			for k = 1, #W do
				Sum += Xi[k] * W[k][j]
			end

			Row[j] = Sum
		end

		Result[i] = Row
	end

	return Result
end

local function LayerNorm(X, Gamma, Beta, Cache)
	local Result = table.create(#X)

	Cache.Input = X
	Cache.Mean = table.create(#X)
	Cache.InvStd = table.create(#X)

	for i = 1, #X do
		local Xi = X[i]

		local Sum = 0

		for d = 1, D do
			Sum += Xi[d]
		end

		local Mean = Sum / D
		local Variance = 0

		for d = 1, D do
			local Diff = Xi[d] - Mean
			Variance += Diff * Diff
		end

		Variance /= D

		local InvStd = 1 / math.sqrt(Variance + 1e-5)

		Cache.Mean[i] = Mean
		Cache.InvStd[i] = InvStd

		local Row = table.create(D)

		for d = 1, D do
			Row[d] =
				((Xi[d] - Mean) * InvStd)
				* Gamma[d]
				+ Beta[d]
		end

		Result[i] = Row
	end

	Cache.Output = Result

	return Result
end

local function LayerNormBackward(DY, Cache, Gamma, GradGamma, GradBeta)
	local X = Cache.Input
	local DX = table.create(#X)

	for i = 1, #X do
		local Xi = X[i]
		local DYi = DY[i]

		local Mean = Cache.Mean[i]
		local InvStd = Cache.InvStd[i]

		local XHat = table.create(D)
		local DXHat = table.create(D)

		local SumDXHat = 0
		local SumDXHatXHat = 0

		for d = 1, D do
			XHat[d] =
				(Xi[d] - Mean)
				* InvStd

			DXHat[d] =
				DYi[d] * Gamma[d]

			GradGamma[d] +=
				DYi[d] * XHat[d]

			GradBeta[d] += DYi[d]

			SumDXHat += DXHat[d]
			SumDXHatXHat +=
				DXHat[d] * XHat[d]
		end

		local Row = table.create(D)

		for d = 1, D do
			Row[d] =
				(InvStd / D)
				* (
					D * DXHat[d]
					- SumDXHat
					- XHat[d] * SumDXHatXHat
				)
		end

		DX[i] = Row
	end

	return DX
end

local function GELUValue(x)
	return 0.5 * x
		* (
			1
			+ math.tanh(
				0.79788456
				* x
				* (1 + 0.044715 * x * x)
			)
		)
end

local function GELUDerivative(x)
	local T =
		math.tanh(
			0.79788456
			* x
			* (1 + 0.044715 * x * x)
		)

	local DT =
		0.79788456
		* (1 + 3 * 0.044715 * x * x)

	return 0.5 * (1 + T)
		+ 0.5 * x
		* (1 - T * T)
		* DT
end

local function GELU(X, Cache)
	Cache.Input = CloneSequence(X)

	local Result = table.create(#X)

	for i = 1, #X do
		Result[i] = table.create(#X[i])

		for d = 1, #X[i] do
			Result[i][d] =
				GELUValue(X[i][d])
		end
	end

	return Result
end

local function GELUBackward(DY, Cache)
	local X = Cache.Input
	local DX = table.create(#X)

	for i = 1, #X do
		DX[i] = table.create(#X[i])

		for d = 1, #X[i] do
			DX[i][d] =
				DY[i][d]
				* GELUDerivative(X[i][d])
		end
	end

	return DX
end

local function Dropout(X, Cache)
	if not Config.Dropout.Enabled then
		Cache.Mask = nil
		return X
	end

	local Rate = Config.Dropout.Rate

	if Rate <= 0 then
		Cache.Mask = nil
		return X
	end

	if Rate >= 1 then
		error("Dropout Rate must be less than 1")
	end

	local ScaleValue = 1 / (1 - Rate)

	local Result = table.create(#X)
	local Mask = table.create(#X)

	for i = 1, #X do
		Result[i] = table.create(D)
		Mask[i] = table.create(D)

		for d = 1, D do
			if RNG:NextNumber() < Rate then
				Result[i][d] = 0
				Mask[i][d] = 0
			else
				Result[i][d] =
					X[i][d] * ScaleValue

				Mask[i][d] = ScaleValue
			end
		end
	end

	Cache.Mask = Mask

	return Result
end

local function DropoutBackward(DY, Cache)
	if not Config.Dropout.Enabled then
		return CloneSequence(DY)
	end

	if not Cache.Mask then
		return CloneSequence(DY)
	end

	local DX = table.create(#DY)

	for i = 1, #DY do
		DX[i] = table.create(D)

		for d = 1, D do
			DX[i][d] =
				DY[i][d]
				* Cache.Mask[i][d]
		end
	end

	return DX
end

local function Softmax(Scores)
	local MaxValue = -math.huge

	for i = 1, #Scores do
		if Scores[i] > MaxValue then
			MaxValue = Scores[i]
		end
	end

	local Sum = 0

	for i = 1, #Scores do
		local Value =
			math.exp(
				Scores[i] - MaxValue
			)

		Scores[i] = Value
		Sum += Value
	end

	if Sum < 1e-12 then
		Sum = 1e-12
	end

	for i = 1, #Scores do
		Scores[i] /= Sum
	end
end

----------------------------------------------------------------
-- SELF ATTENTION
----------------------------------------------------------------

local function SelfAttention(X, Layer, Cache)
	local N = #X

	local Q = Linear(X, Layer.Wq, Layer.Bq)
	local K = Linear(X, Layer.Wk, Layer.Bk)
	local V = Linear(X, Layer.Wv, Layer.Bv)

	Cache.Input = X
	Cache.Q = Q
	Cache.K = K
	Cache.V = V
	Cache.Attention = table.create(Heads)

	local Context = table.create(N)

	for h = 1, Heads do
		Cache.Attention[h] = table.create(N)
	end

	for i = 1, N do
		Context[i] = table.create(D, 0)

		for h = 1, Heads do
			local Offset =
				(h - 1) * HeadDim

			local Scores = table.create(i)

			for j = 1, i do
				local Dot = 0

				for d = 1, HeadDim do
					local Index = Offset + d

					Dot +=
						Q[i][Index]
						* K[j][Index]
				end

				Scores[j] =
					Dot * Scale
			end

			Softmax(Scores)

			Cache.Attention[h][i] =
				Scores

			for j = 1, i do
				local Weight = Scores[j]

				for d = 1, HeadDim do
					local Index = Offset + d

					Context[i][Index] +=
						Weight * V[j][Index]
				end
			end
		end
	end

	Cache.Context = Context

	local Output =
		Linear(
			Context,
			Layer.Wo,
			Layer.Bo
		)

	Cache.Output = Output

	return Output
end

local function SelfAttentionBackward(
	DY,
	Layer,
	Cache,
	Grad
)
	local X = Cache.Input
	local Q = Cache.Q
	local K = Cache.K
	local V = Cache.V
	local Context = Cache.Context
	local Attention = Cache.Attention

	local N = #DY

	local DContext = table.create(N)
	local DQ = table.create(N)
	local DK = table.create(N)
	local DV = table.create(N)
	local DX = table.create(N)

	for i = 1, N do
		DContext[i] = table.create(D, 0)
		DQ[i] = table.create(D, 0)
		DK[i] = table.create(D, 0)
		DV[i] = table.create(D, 0)
		DX[i] = table.create(D, 0)
	end

	------------------------------------------------------------
	-- OUTPUT LINEAR: Context -> Wo
	------------------------------------------------------------

	for i = 1, N do
		for inputIndex = 1, D do
			local Sum = 0

			for outputIndex = 1, D do
				Sum +=
					DY[i][outputIndex]
					* Layer.Wo[inputIndex][outputIndex]

				Grad.dWo[inputIndex][outputIndex] +=
					Context[i][inputIndex]
					* DY[i][outputIndex]
			end

			DContext[i][inputIndex] = Sum
		end

		for outputIndex = 1, D do
			Grad.dBo[outputIndex] +=
				DY[i][outputIndex]
		end
	end

	------------------------------------------------------------
	-- ATTENTION
	------------------------------------------------------------

	for h = 1, Heads do
		local Offset =
			(h - 1) * HeadDim

		for i = 1, N do
			local Scores =
				Attention[h][i]

			local DAttention =
				table.create(i)

			local SoftmaxSum = 0

			for j = 1, i do
				local Value = 0

				for d = 1, HeadDim do
					local Index = Offset + d

					Value +=
						DContext[i][Index]
						* V[j][Index]
				end

				DAttention[j] = Value

				SoftmaxSum +=
					Value * Scores[j]
			end

			for j = 1, i do
				local Weight = Scores[j]

				local DScore =
					Weight
					* (
						DAttention[j]
						- SoftmaxSum
					)

				for d = 1, HeadDim do
					local Index = Offset + d

					DQ[i][Index] +=
						DScore
						* K[j][Index]
						* Scale

					DK[j][Index] +=
						DScore
						* Q[i][Index]
						* Scale

					DV[j][Index] +=
						Weight
						* DContext[i][Index]
				end
			end
		end
	end

	------------------------------------------------------------
	-- Q / K / V LINEAR
	------------------------------------------------------------

	for i = 1, N do
		for d = 1, D do
			local GQ = DQ[i][d]
			local GK = DK[i][d]
			local GV = DV[i][d]

			Grad.dBq[d] += GQ
			Grad.dBk[d] += GK
			Grad.dBv[d] += GV

			for k = 1, D do
				DX[i][k] +=
					GQ * Layer.Wq[k][d]
					+ GK * Layer.Wk[k][d]
					+ GV * Layer.Wv[k][d]

				Grad.dWq[k][d] +=
					X[i][k] * GQ

				Grad.dWk[k][d] +=
					X[i][k] * GK

				Grad.dWv[k][d] +=
					X[i][k] * GV
			end
		end
	end

	return DX
end

----------------------------------------------------------------
-- FFN
----------------------------------------------------------------

local function FFN(X, Layer, Cache)
	Cache.Input = X

	local HiddenPre = table.create(#X)

	for i = 1, #X do
		HiddenPre[i] =
			table.create(Hidden)

		for h = 1, Hidden do
			local Sum = Layer.B1[h]

			for d = 1, D do
				Sum +=
					X[i][d]
					* Layer.W1[h][d]
			end

			HiddenPre[i][h] =
				Sum
		end
	end

	Cache.HiddenPre = HiddenPre
	Cache.GELU = {}

	local HiddenValues =
		GELU(
			HiddenPre,
			Cache.GELU
		)

	Cache.Hidden = HiddenValues

	local Output = table.create(#X)

	for i = 1, #X do
		Output[i] = table.create(D)

		for d = 1, D do
			local Sum = Layer.B2[d]

			for h = 1, Hidden do
				Sum +=
					HiddenValues[i][h]
					* Layer.W2[d][h]
			end

			Output[i][d] = Sum
		end
	end

	Cache.Output = Output

	return Output
end

local function FFNBackward(
	DY,
	Layer,
	Cache,
	Grad
)
	local X = Cache.Input
	local HiddenValues = Cache.Hidden

	local DHidden =
		table.create(#X)

	local DX =
		table.create(#X)

	for i = 1, #X do
		DHidden[i] =
			table.create(Hidden, 0)

		DX[i] =
			table.create(D, 0)
	end

	------------------------------------------------------------
	-- W2
	------------------------------------------------------------

	for i = 1, #X do
		for d = 1, D do
			local G = DY[i][d]

			Grad.dB2[d] += G

			for h = 1, Hidden do
				Grad.dW2[d][h] +=
					G * HiddenValues[i][h]

				DHidden[i][h] +=
					G * Layer.W2[d][h]
			end
		end
	end

	------------------------------------------------------------
	-- GELU
	------------------------------------------------------------

	local DGELU =
		GELUBackward(
			DHidden,
			Cache.GELU
		)

	------------------------------------------------------------
	-- W1
	------------------------------------------------------------

	for i = 1, #X do
		for h = 1, Hidden do
			local G = DGELU[i][h]

			Grad.dB1[h] += G

			for d = 1, D do
				Grad.dW1[h][d] +=
					G * X[i][d]

				DX[i][d] +=
					G * Layer.W1[h][d]
			end
		end
	end

	return DX
end

----------------------------------------------------------------
-- FORWARD
----------------------------------------------------------------

function TransformerBlock.Forward(Input, LayerIndex)
	if #Input == 0 then
		error("TransformerBlock received empty input")
	end

	if #Input > ContextSize then
		error(
			"Sequence length "
				.. #Input
				.. " exceeds ContextSize "
				.. ContextSize
		)
	end

	local Layer =
		Params.Layers[LayerIndex]

	if not Layer then
		error(
			"Layer "
				.. tostring(LayerIndex)
				.. " does not exist"
		)
	end

	Params.Cache =
		Params.Cache or {}

	local Cache =
		Params.Cache[LayerIndex]

	if not Cache then
		Cache = {}

		Params.Cache[LayerIndex] =
			Cache
	end

	Cache.Input =
		CloneSequence(Input)

	------------------------------------------------------------
	-- LN1
	------------------------------------------------------------

	Cache.LN1 = {}

	local LN1 =
		LayerNorm(
			Input,
			Layer.LN1_Gamma,
			Layer.LN1_Beta,
			Cache.LN1
		)

	------------------------------------------------------------
	-- MHA
	------------------------------------------------------------

	Cache.MHA = {}

	local Attention =
		SelfAttention(
			LN1,
			Layer,
			Cache.MHA
		)

	------------------------------------------------------------
	-- ATTENTION DROPOUT
	------------------------------------------------------------

	Cache.AttentionDropout = {}

	local AttentionDropped =
		Dropout(
			Attention,
			Cache.AttentionDropout
		)

	------------------------------------------------------------
	-- RESIDUAL 1
	------------------------------------------------------------

	local Residual1 =
		table.create(#Input)

	for i = 1, #Input do
		Residual1[i] =
			table.create(D)

		for d = 1, D do
			Residual1[i][d] =
				Input[i][d]
				+ AttentionDropped[i][d]
		end
	end

	Cache.Residual1 =
		Residual1

	------------------------------------------------------------
	-- LN2
	------------------------------------------------------------

	Cache.LN2 = {}

	local LN2 =
		LayerNorm(
			Residual1,
			Layer.LN2_Gamma,
			Layer.LN2_Beta,
			Cache.LN2
		)

	------------------------------------------------------------
	-- FFN
	------------------------------------------------------------

	Cache.FFN = {}

	local FFNOutput =
		FFN(
			LN2,
			Layer,
			Cache.FFN
		)

	------------------------------------------------------------
	-- FFN DROPOUT
	------------------------------------------------------------

	Cache.FFNDropout = {}

	local FFNDropped =
		Dropout(
			FFNOutput,
			Cache.FFNDropout
		)

	------------------------------------------------------------
	-- RESIDUAL 2
	------------------------------------------------------------

	local Output =
		table.create(#Input)

	for i = 1, #Input do
		Output[i] =
			table.create(D)

		for d = 1, D do
			Output[i][d] =
				Residual1[i][d]
				+ FFNDropped[i][d]
		end
	end

	Cache.Output =
		Output

	return Output
end

----------------------------------------------------------------
-- BACKWARD
----------------------------------------------------------------

function TransformerBlock.Backward(DOutput, LayerIndex)
	local Layer =
		Params.Layers[LayerIndex]

	local Cache =
		Params.Cache[LayerIndex]

	local Grad =
		Params.Gradients[LayerIndex]

	if not Layer then
		error(
			"Layer "
				.. tostring(LayerIndex)
				.. " does not exist"
		)
	end

	if not Cache then
		error(
			"No forward cache for layer "
				.. tostring(LayerIndex)
		)
	end

	if not Grad then
		error(
			"No gradients for layer "
				.. tostring(LayerIndex)
		)
	end

	------------------------------------------------------------
	-- RESIDUAL 2
	------------------------------------------------------------

	local DResidual1 =
		CloneSequence(DOutput)

	local DFFNOutput =
		DropoutBackward(
			DOutput,
			Cache.FFNDropout
		)

	------------------------------------------------------------
	-- FFN
	------------------------------------------------------------

	local DLN2 =
		FFNBackward(
			DFFNOutput,
			Layer,
			Cache.FFN,
			Grad
		)

	------------------------------------------------------------
	-- LN2
	------------------------------------------------------------

	local DResidualFromLN2 =
		LayerNormBackward(
			DLN2,
			Cache.LN2,
			Layer.LN2_Gamma,
			Grad.dLN2_Gamma,
			Grad.dLN2_Beta
		)

	for i = 1, #DResidual1 do
		for d = 1, D do
			DResidual1[i][d] +=
				DResidualFromLN2[i][d]
		end
	end

	------------------------------------------------------------
	-- RESIDUAL 1
	------------------------------------------------------------

	local DAttentionOutput =
		DropoutBackward(
			DResidual1,
			Cache.AttentionDropout
		)

	------------------------------------------------------------
	-- MHA
	------------------------------------------------------------

	local DLN1 =
		SelfAttentionBackward(
			DAttentionOutput,
			Layer,
			Cache.MHA,
			Grad
		)

	------------------------------------------------------------
	-- LN1
	------------------------------------------------------------

	local DInput =
		LayerNormBackward(
			DLN1,
			Cache.LN1,
			Layer.LN1_Gamma,
			Grad.dLN1_Gamma,
			Grad.dLN1_Beta
		)

	------------------------------------------------------------
	-- RESIDUAL 1 -> INPUT
	------------------------------------------------------------

	for i = 1, #DInput do
		for d = 1, D do
			DInput[i][d] +=
				DResidual1[i][d]
		end
	end

	return DInput
end

----------------------------------------------------------------
-- CACHE
----------------------------------------------------------------

function TransformerBlock.ClearCache(LayerIndex)
	Params.Cache[LayerIndex] = {}
end

return TransformerBlock
