local Initialized = false

local function Vector(Size, Value)
	local T = table.create(Size)

	for i = 1, Size do
		T[i] = Value or 0
	end

	return T
end

local function Matrix(Rows, Cols, Scale, RNG)
	local T = table.create(Rows)

	for i = 1, Rows do
		T[i] = table.create(Cols)

		for j = 1, Cols do
			T[i][j] = RNG:NextNumber(-Scale, Scale)
		end
	end

	return T
end

local function ZeroMatrix(Rows, Cols)
	local T = table.create(Rows)

	for i = 1, Rows do
		T[i] = table.create(Cols)

		for j = 1, Cols do
			T[i][j] = 0
		end
	end

	return T
end

local function Xavier(InSize, OutSize)
	return math.sqrt(6 / (InSize + OutSize))
end


function Params.Initialize(Config)
	if Initialized then
		return
	end

	local RNG = Random.new(1234)

	local D = Config.Dimension
	local Layers = Config.Model.Layers
	local Heads = Config.Model.Heads
	local Hidden = Config.Model.FFNSize or D * 4

	if D % Heads ~= 0 then
		error("Dimension must be divisible by Heads")
	end


	-- =========================
	-- TOKENIZER
	-- =========================

	Params.Vocab = {
		["<PAD>"] = 0,
		["<UNK>"] = 1,
		["<BOS>"] = 2,
		["<EOS>"] = 3,
		["<SEP>"] = 4,
	}

	Params.IDToToken = {
		[0] = "<PAD>",
		[1] = "<UNK>",
		[2] = "<BOS>",
		[3] = "<EOS>",
		[4] = "<SEP>",
	}

	Params.VocabSize = 5
	Params.Merges = {}


	-- =========================
	-- EMBEDDING
	-- =========================

	Params.Embedding = {}

	for ID = 0, 4 do
		Params.Embedding[ID] = Vector(D)

		if ID ~= 0 then
			for i = 1, D do
				Params.Embedding[ID][i] =
					RNG:NextNumber(-0.1, 0.1)
			end
		end
	end


	-- =========================
	-- LAYERS
	-- =========================

	Params.Layers = {}
	Params.Gradients = {}
	Params.Cache = {}

	for LayerIndex = 1, Layers do
		local QKVOScale = Xavier(D, D)
		local FF1Scale = Xavier(D, Hidden)
		local FF2Scale = Xavier(Hidden, D)

		Params.Layers[LayerIndex] = {
			Wq = Matrix(D, D, QKVOScale, RNG),
			Wk = Matrix(D, D, QKVOScale, RNG),
			Wv = Matrix(D, D, QKVOScale, RNG),
			Wo = Matrix(D, D, QKVOScale, RNG),

			Bq = Vector(D),
			Bk = Vector(D),
			Bv = Vector(D),
			Bo = Vector(D),

			LN1_Gamma = Vector(D, 1),
			LN1_Beta = Vector(D),

			W1 = Matrix(Hidden, D, FF1Scale, RNG),
			B1 = Vector(Hidden),

			W2 = Matrix(D, Hidden, FF2Scale, RNG),
			B2 = Vector(D),

			LN2_Gamma = Vector(D, 1),
			LN2_Beta = Vector(D),
		}

		Params.Gradients[LayerIndex] = {
			dWq = ZeroMatrix(D, D),
			dWk = ZeroMatrix(D, D),
			dWv = ZeroMatrix(D, D),
			dWo = ZeroMatrix(D, D),

			dBq = Vector(D),
			dBk = Vector(D),
			dBv = Vector(D),
			dBo = Vector(D),

			dLN1_Gamma = Vector(D),
			dLN1_Beta = Vector(D),

			dW1 = ZeroMatrix(Hidden, D),
			dB1 = Vector(Hidden),

			dW2 = ZeroMatrix(D, Hidden),
			dB2 = Vector(D),

			dLN2_Gamma = Vector(D),
			dLN2_Beta = Vector(D),
		}

		Params.Cache[LayerIndex] = {}
	end


	-- =========================
	-- OUTPUT
	-- =========================

	Params.Output = {
		W = Matrix(
			D,
			Params.VocabSize,
			Xavier(D, Params.VocabSize),
			RNG
		),

		B = Vector(Params.VocabSize),

		dW = ZeroMatrix(
			D,
			Params.VocabSize
		),

		dB = Vector(Params.VocabSize),
	}

	Initialized = true
end
